{
  "manifest_version": 3,
  "name": "Discord Search",
  "version": "1.1",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "เปิด/ปิด ที่ค้นหา"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://54.206.105.0:5000/*"
  ]
}